@startuml
title UML-Use-Case-Diagramm: ShiftPlanner

left to right direction

actor "Führungskraft" as chef
actor "Mitarbeitende" as employee

rectangle "ShiftPlanner" {
  usecase "Bedarf erfassen\n(UC-01)" as UC1
  usecase "Verfügbarkeiten\neintragen\n(UC-02)" as UC2
  usecase "Urlaub eintragen\n(UC-03)" as UC3
  usecase "Plan erzeugen\n(UC-04)" as UC4
  usecase "Plan veröffentlichen\n(UC-05)" as UC5
}

chef --> UC1
chef --> UC4
chef --> UC5

employee --> UC2
employee --> UC3

UC4 ..> UC2 : <<include>>
UC4 ..> UC3 : <<include>>

note right of UC4
  Automatische Zuordnung\nmit Priorität 1-3\nMarkiert unbesetzte Schichten
end note

@enduml
