@startuml
title UML-Use-Case-Diagramm: ShiftPlanner (UC-01 bis UC-05, Stand Sprint 1)

left to right direction
skinparam packageStyle rectangle

actor "Chef / Planung" as chef
actor "Mitarbeitende" as employee

rectangle "ShiftPlanner" {
  usecase "UC-01 Betrieb einrichten\n(Vorlagen, Qualifikationen,\nMitarbeitende anlegen)" as UC1
  usecase "UC-02 Planungsmonat und\nBedarf festlegen\n(Abgabefrist, Öffnungstage,\nBedarf, Urlaub)" as UC2
  usecase "UC-03 Verfügbarkeiten\nabgeben (Priorität 1–3)" as UC3
  usecase "UC-04 Schichtplan\nerzeugen" as UC4
  usecase "UC-05 Schichtplan\nansehen (nur lesend)" as UC5
  usecase "Plan manuell korrigieren\n(REQ-11, in Arbeit)" as UC6
  usecase "Plan veröffentlichen\n(REQ-15, Sprint 2)" as UC7
}

chef --> UC1
chef --> UC2
chef --> UC4
chef --> UC5
employee --> UC3

UC6 .> UC5 : <<extend>>
UC7 .> UC5 : <<extend>>

note right of UC4
  Vorbedingung: Bedarf gespeichert und
  alle haben abgegeben ODER Frist abgelaufen.
  Prüft Urlaub, Überschneidung und ArbZG (RB-01).
end note

@enduml
