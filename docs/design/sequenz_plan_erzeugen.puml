@startuml
title Sequenzdiagramm: Plan erzeugen (UC-04, Stand 23.11.2026)

actor "Chef / Planung" as chef
participant "Browser" as browser
participant "Views\n(generate)" as views
participant "Services\n(services.py)" as services
participant "Regeln\n(rules.py)" as rules
participant "Models\n(Django-ORM)" as models
database "SQLite lokal / PostgreSQL" as db

chef -> browser : Eingaben prüfen, Erzeugung auslösen
browser -> views : POST /plan/erzeugen/\nmonth, optional confirm_incomplete=yes
views -> views : planner_only / with_context\nAnmeldung, Rolle, Betrieb und Monat prüfen
alt nicht angemeldet
  views --> browser : Redirect zur Anmeldung (302)
else keine Planungsrolle oder keine Betriebszuordnung
  views --> browser : HTTP 403
else ungültiger Planungsmonat
  views --> browser : HTTP 400
else gültiger Zugriff
  note over views, services
    with_context bestimmt den Monat im eigenen Betrieb,
    bereitet Slots vor und liefert die Vorschau des Abgabestands.
  end note
  views -> services : generate_plan(month,\nallow_incomplete = confirm_incomplete == 'yes')
  group atomare Datenbanktransaktion
    services -> models : Monat laden (select_for_update)
    models -> db : SELECT Monat\nZeilensperre auf PostgreSQL
    services -> services : readiness(month)
    note right of services
      can_generate = Bedarf gespeichert
      UND Positionenzahl > 0
      UND aktive Mitarbeitende im Betrieb vorhanden.
      Offene Abgaben brauchen ausdrückliche Bestätigung,
      unabhängig davon, ob die Abgabefrist abgelaufen ist.
    end note
    alt can_generate ist False
      services --> views : ValueError, Transaktion zurückrollen
      views --> browser : Erzeugungsseite mit Fehlermeldung (200)
    else offene Abgaben UND allow_incomplete ist False
      services --> views : ValueError: offene Abgaben prüfen und bestätigen
      views --> browser : Erzeugungsseite mit Fehlermeldung (200)
    else Erzeugung zulässig
      services -> models : Slots der Öffnungstage mit Bedarf, eigene Mitarbeitende,\nQualifikationen, abgegebene Verfügbarkeiten und Urlaube laden
      models -> db : SELECT
      loop je Slot, chronologisch
        services -> services : Bedarf in qualifizierte und freie Positionen auflösen
        opt Besetzungsmix übersteigt die Gesamtzahl
          break Erzeugung abbrechen
            services --> views : ValueError; gesamte Transaktion zurückrollen
            views --> browser : Erzeugungsseite mit Fehlermeldung (200)
          end
        end
        loop je verfügbarer Kandidat mit abgegebenen Angaben
          services -> services : is_eligible(shift, assigned, vacations)\nUrlaub und Überschneidung ausschließen
          opt kein Urlaub und keine Überschneidung
            services -> rules : is_allowed(assigned, shift)
            rules --> services : True / False
          end
        end
        services -> services : Qualifikationen je Position filtern; match_positions()\nP1 vor P2 vor P3, deterministisch
      end
      services -> models : Plan anlegen oder aktualisieren;\nalte Entwurfspositionen löschen, neue Positionen speichern
      models -> db : INSERT oder UPDATE Plan; DELETE alte Assignments;\nINSERT neue Assignments; UPDATE Laufzeit
      note over models, db
        Unbesetzt = employee NULL.
        Ein vorhandener PublishedPlan mit PublishedAssignments bleibt erhalten.
        Bei Fehlern werden sämtliche Änderungen zurückgerollt.
      end note
      services --> views : Plan mit duration_ms
    end
  end
  opt Plan erfolgreich erzeugt
    views --> browser : Redirect /plan/?month=...&week=... (302)\nbearbeitbarer Entwurf
  end
end
@enduml
