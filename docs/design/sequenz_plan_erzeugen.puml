@startuml
!pragma layout smetana
title Sequenzdiagramm: Plan erzeugen (UC-04, Stand 23.11.2026)

actor "Chef / Planung" as chef
participant "Browser" as browser
participant "Views\n(generate)" as views
participant "Services\n(services.py)" as services
participant "Regeln\n(rules.py)" as rules
participant "Models" as models
database "Datenbank\n(SQLite / PostgreSQL)" as db

chef -> browser : Klick „Schichtplan erzeugen“\n(bei offenen Abgaben: Bestätigung anhaken)
browser -> views : POST /plan/erzeugen/ [confirm_incomplete=yes]
views -> views : planner_only (Rolle und Betrieb prüfen)

alt keine Planungsrolle oder kein Betrieb
  views --> browser : HTTP 403
else Planungsrolle
  views -> services : generate_plan(month, allow_incomplete)
  services -> models : Monat sperren (select_for_update)
  services -> services : readiness(month)
  note right
    can_generate = Bedarf gespeichert,
    Positionen > 0, aktive Mitarbeitende
    missing = offene Abgaben
  end note

  alt nicht erzeugbar (can_generate = False)
    services --> views : ValueError
    views --> browser : Fehlermeldung (UC-04 1a)
  else offene Abgaben ohne Bestätigung
    services --> views : ValueError
    views --> browser : „Offene Abgaben prüfen und bestätigen“
  else erzeugbar (alle abgegeben oder bestätigt; auch vor Fristablauf)
    services -> models : Slots der Öffnungstage (total > 0),\nnur abgegebene Verfügbarkeiten, Urlaube
    models -> db : SELECT
    loop je Slot, chronologisch
      services -> services : Besetzungsmix ≤ Gesamtzahl?
      loop je Kandidat
        services -> services : is_eligible(shift, assigned, vacations)\nUrlaub? Überschneidung?
        services -> rules : is_allowed(assigned, shift)
        rules --> services : True / False (10 h/Tag, 48 h/Woche, 11 h Ruhe)
      end
      services -> services : match_positions()\nP1 vor P2 vor P3, deterministisch
    end
    services -> models : Plan anlegen oder aktualisieren (update_or_create),\nalte Entwurfspositionen löschen, neue speichern\n(unbesetzt = employee NULL)
    models -> db : INSERT/UPDATE plan, DELETE + INSERT assignments
    note right of models
      Die veröffentlichte Kopie (PublishedPlan)
      bleibt unverändert, bis erneut
      veröffentlicht wird (REQ-15).
    end note
    services --> views : Plan (duration_ms)
    views --> browser : Redirect /plan/ (bearbeitbarer Entwurf)
  end
end

@enduml
