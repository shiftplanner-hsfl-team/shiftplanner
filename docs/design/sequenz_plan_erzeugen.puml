@startuml
title Sequenzdiagramm: Plan erzeugen (UC-04, Stand Sprint 1)

actor "Chef / Planung" as chef
participant "Browser" as browser
participant "Views\n(generate)" as views
participant "Services\n(services.py)" as services
participant "Regeln\n(rules.py)" as rules
participant "Models" as models
database "SQLite" as db

chef -> browser : Klick „Schichtplan erzeugen“
browser -> views : POST /plan/erzeugen/
views -> views : planner_only (Rolle prüfen)

alt keine Planungsrolle
  views --> browser : HTTP 403
else Planungsrolle
  views -> services : generate_plan(month)
  services -> services : readiness(month)
  note right
    ready = Bedarf gespeichert
    und (alle abgegeben oder Frist abgelaufen)
  end note

  alt nicht bereit
    services --> views : ValueError
    views --> browser : Fehlermeldung (UC-04 1a)
  else bereit
    services -> models : Slots der Öffnungstage (month_slots)\nnur abgegebene Verfügbarkeiten, Urlaube
    models -> db : SELECT
    loop je Slot, chronologisch
      loop je Kandidat
        services -> services : is_eligible(shift, assigned, vacations)\nUrlaub? Überschneidung?
        services -> rules : is_allowed(assigned, shift)
        rules --> services : True / False (10 h/Tag, 48 h/Woche, 11 h Ruhe)
      end
      services -> services : match_positions()\nP1 vor P2 vor P3, deterministisch
    end
    services -> models : Plan + Assignments als Snapshot\n(unbesetzt = employee NULL)
    models -> db : INSERT plan, assignments
    services --> views : Plan (duration_ms)
    views --> browser : Redirect /plan/ (nur lesend)
  end
end

@enduml
