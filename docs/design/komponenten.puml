@startuml
!pragma layout smetana
skinparam componentStyle rectangle
skinparam backgroundColor #FEFEFE
skinparam componentBackgroundColor #E3F2FD
skinparam componentBorderColor #1976D2
skinparam componentFontColor #000000

title ShiftPlanner – Komponentenübersicht (Schichtenarchitektur, Stand 23.11.2026)

package "1. Darstellung" {
  [Templates\n(Django Templates)] as templates
  [Static Files\n(CSS, JS)] as static
  [Template-Filter\n(templatetags: holiday)] as tags
}

package "2. Zugriff und Abläufe" {
  [Views\n(urls.py, views.py)] as views
  [Forms\n(forms.py)] as forms
}

package "3. Planung" {
  [Services\n(services.py)] as services
  [Korrektur\n(corrections.py, REQ-11)] as corrections
  [Auffüllen\n(autofill.py, REQ-09)] as autofill
  [Veröffentlichung\n(publications.py, REQ-15)] as publications
  [Regelmodul\n(rules.py: RB-01, RB-03)] as rules
}

package "4. Persistenz" {
  [Models\n(models.py)] as models
  database "SQLite (lokal, CI)\nPostgreSQL 18 (Demo, CI)" as db
}

templates --> views : HTTP-Anfrage / render
templates ..> static
templates --> tags
tags ..> rules : holiday_name()
views --> forms : Validierung
views --> services : generate_plan(), readiness() u. a.
views --> corrections : correct_plan()
views --> autofill : fill_unassigned()
views --> publications : publication_preview(), publish_plan()
views ..> rules : Anzeige (Shift, Feiertage)
views --> models : Lesen für Anzeige
forms --> models : ModelForm / Querysets
corrections --> rules : violations()
corrections ..> services : overlaps()
autofill ..> services : is_eligible(), match_positions()
autofill ..> rules : Shift
publications ..> services : today()
services --> rules : is_allowed() / violations()
services --> models : Datenzugriff (ORM)
corrections --> models
autofill --> models
publications --> models
models --> db

note bottom of rules
  Ohne Datenbank- und HTTP-Zugriff.
  Grenzwerte als Konstanten:
  10 h/Tag, 48 h/Woche, 11 h Ruhezeit,
  Pausen nach § 4 ArbZG.
end note

note right of services
  Information Hiding: Views kennen
  die Algorithmen nicht, nur die
  dokumentierten Funktionen der
  Planungsmodule.
end note

@enduml
