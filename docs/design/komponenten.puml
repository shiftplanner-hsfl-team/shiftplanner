@startuml
!pragma layout smetana
skinparam componentStyle rectangle
skinparam backgroundColor #FEFEFE
skinparam componentBackgroundColor #E3F2FD
skinparam componentBorderColor #1976D2
skinparam componentFontColor #000000

title ShiftPlanner – Komponentenübersicht (Stand 23.11.2026)

actor "Browser" as browser
package "1. Darstellung" {
  [Templates\n(templates/planning/)] as templates
  [Static Files\n(static/planning/)] as static
  [Template-Filter\n(templatetags/planning_extras.py)] as tags
}
package "2. Zugriff und Abläufe" {
  [Routen\n(shiftplanner/urls.py)] as urls
  [Views\n(views.py)] as views
  [Forms\n(forms.py)] as forms
}
package "3. Fachlogik und Regeln" {
  [Services\n(services.py)] as services
  [Plankorrektur\n(corrections.py)] as corrections
  [Freie Positionen auffüllen\n(autofill.py)] as autofill
  [Veröffentlichung und Plansicht\n(publications.py)] as publications
  [Regelmodul\n(rules.py: RB-01, RB-03)] as rules
}
package "4. Persistenz" {
  [Models\n(models.py, Django-ORM)] as models
  database "SQLite lokal\nPostgreSQL in Demo und CI" as db
}

browser ..> urls : HTTP-Anfrage
urls --> views
views ..> templates : render()
templates ..> static : CSS / JS
templates ..> tags : Filter laden
tags --> rules : holiday_name()
views --> forms
views --> services
views --> corrections
views --> autofill
views --> publications
views --> models
views --> rules
forms --> models
services --> models
services --> rules
corrections --> services
corrections --> models
corrections --> rules
autofill --> services
autofill --> models
autofill --> rules
publications --> models
publications --> services : Monatsdaten / Datum
models --> db : ORM

note bottom of rules
  Ohne Datenbank- und HTTP-Abhängigkeit.
  Grenzwerte zentral: 10 h/Tag, 48 h/Woche,
  11 h Ruhezeit, Pausen nach § 4 ArbZG.
end note

legend bottom
  Durchgezogen: lokale Python-Modulabhängigkeit bzw. ORM-Datenzugriff.
  Gestrichelt: HTTP-, Render- oder Ressourcenfluss.
  Views und Forms greifen auch direkt auf Models zu.
  Fachmodule haben keine Rückabhängigkeit auf Views oder Forms.
endlegend
@enduml
