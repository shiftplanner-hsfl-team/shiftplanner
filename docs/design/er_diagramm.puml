@startuml
title ER-Diagramm: 13 Tabellen der App + Django-Benutzer (Krähenfußnotation, Stand Sprint 1)

hide circle
skinparam linetype ortho

entity auth_user {
  * id : int <<PK>>
  --
  username : varchar <<unique>>
  first_name : varchar
  last_name : varchar
  is_active : boolean
}

entity Employee {
  * id : int <<PK>>
  --
  user_id : int <<FK, unique>>
  contract_type : varchar
  weekly_hours : decimal(4,1) <<null>>
}

entity Qualification {
  * id : int <<PK>>
  --
  name : varchar <<unique>>
  description : varchar
}

entity Employee_Qualification {
  * employee_id : int <<FK>>
  * qualification_id : int <<FK>>
}

entity ShiftTemplate {
  * id : int <<PK>>
  --
  name : varchar <<unique>>
  start : time
  end : time
  description : varchar
}

entity Month {
  * id : int <<PK>>
  --
  date : date <<unique>>
  revision : int
  demand_saved : boolean
  deadline : date <<null>>
  open_weekdays : varchar(7)
}

entity MonthDay {
  * id : int <<PK>>
  --
  month_id : int <<FK>>
  date : date
  is_open : boolean
  ..
  unique (month_id, date)
}

entity Slot {
  * id : int <<PK>>
  --
  month_id : int <<FK>>
  template_id : int <<FK>>
  date : date
  total : smallint
  ..
  unique (date, template_id)
}

entity Need {
  * id : int <<PK>>
  --
  slot_id : int <<FK>>
  qualification_id : int <<FK>>
  count : smallint
  ..
  unique (slot_id, qualification_id)
}

entity Availability {
  * id : int <<PK>>
  --
  employee_id : int <<FK>>
  slot_id : int <<FK>>
  priority : smallint
  ..
  unique (employee_id, slot_id)
}

entity Submission {
  * id : int <<PK>>
  --
  employee_id : int <<FK>>
  month_id : int <<FK>>
  submitted : boolean
  updated_at : datetime
  ..
  unique (employee_id, month_id)
}

entity Vacation {
  * id : int <<PK>>
  --
  employee_id : int <<FK>>
  start : date
  end : date
}

entity Plan {
  * id : int <<PK>>
  --
  month_id : int <<FK, unique>>
  revision : int
  created_at : datetime
  duration_ms : int
}

entity Assignment {
  * id : int <<PK>>
  --
  plan_id : int <<FK>>
  slot_id : int <<FK>>
  employee_id : int <<FK, null>>
  position : smallint
  role : varchar
  priority : smallint <<null>>
  date : date
  shift_name : varchar
  start : time
  end : time
  employee_name : varchar
  ..
  unique (plan_id, slot_id, position)
}

auth_user ||--|| Employee
Employee ||--o{ Employee_Qualification
Qualification ||--o{ Employee_Qualification
Employee ||--o{ Availability
Employee ||--o{ Submission
Employee ||--o{ Vacation
Employee |o--o{ Assignment

Month ||--o{ MonthDay
Month ||--o{ Slot
Month ||--o{ Submission
Month ||--o| Plan
ShiftTemplate ||--o{ Slot
Slot ||--o{ Need
Qualification ||--o{ Need
Slot ||--o{ Availability
Plan ||--o{ Assignment
Slot ||--o{ Assignment

@enduml
