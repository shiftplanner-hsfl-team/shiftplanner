@startuml
title ER-Diagramm: 13 Tabellen (Krähenfußnotation)

entity Employee {
  * id : int <<PK>>
  --
  user_id : int <<FK>>
  contract_type : varchar
  min_hours : decimal
  max_hours : decimal
  is_active : boolean
}

entity Qualification {
  * id : int <<PK>>
  --
  name : varchar
}

entity Employee_Qualification {
  * employee_id : int <<PK,FK>>
  * qualification_id : int <<PK,FK>>
}

entity ShiftTemplate {
  * id : int <<PK>>
  --
  name : varchar
  start_time : time
  end_time : time
}

entity Month {
  * id : int <<PK>>
  --
  year : int
  month : int
  need_status : varchar
  revision : int
}

entity Slot {
  * id : int <<PK>>
  --
  date : date
  template_id : int <<FK>>
  total_need : int
}

entity Need {
  * id : int <<PK>>
  --
  slot_id : int <<FK>>
  qualification_id : int <<FK>>
  count : int
}

entity Availability {
  * id : int <<PK>>
  --
  employee_id : int <<FK>>
  slot_id : int <<FK>>
  priority : int
}

entity Submission {
  * id : int <<PK>>
  --
  employee_id : int <<FK>>
  month_id : int <<FK>>
  status : varchar
}

entity Leave {
  * id : int <<PK>>
  --
  employee_id : int <<FK>>
  start_date : date
  end_date : date
}

entity Plan {
  * id : int <<PK>>
  --
  month_id : int <<FK>>
  created_at : datetime
  duration_ms : float
  is_published : boolean
}

entity Assignment {
  * id : int <<PK>>
  --
  plan_id : int <<FK>>
  slot_id : int <<FK>>
  employee_id : int <<FK>>
  need_id : int <<FK>>
}

Employee ||--o{ Employee_Qualification : hat
Qualification ||--o{ Employee_Qualification : wird besessen von

Employee ||--o{ Availability : trägt ein
Employee ||--o{ Submission : gibt ab
Employee ||--o{ Leave : nimmt
Employee ||--o{ Assignment : wird zugewiesen

Month ||--|{ Slot : enthält
Slot }|--|| ShiftTemplate : nutzt

Slot ||--|{ Need : hat
Qualification ||--o{ Need : erfordert

Plan ||--|{ Assignment : enthält

@enduml
