@startuml
!pragma layout smetana
title ER-Diagramm: 18 Tabellen der App + Django-Benutzer (Krähenfußnotation, Stand 23.11.2026)

hide circle
skinparam linetype ortho

entity auth_user {
  * id : int <<PK>>
  --
  username : varchar <<unique>>
  first_name : varchar
  last_name : varchar
  is_active : boolean
}

entity Company {
  * id : int <<PK>>
  --
  name : varchar
  slug : varchar <<unique>>
  branch : varchar
}

entity CompanyAccount {
  * id : int <<PK>>
  --
  user_id : int <<FK, unique>>
  company_id : int <<FK>>
}

entity PlanningSettings {
  * id : smallint <<PK>>
  --
  company_id : int <<FK, unique>>
  show_team_plan : boolean
}

entity Employee {
  * id : int <<PK>>
  --
  company_id : int <<FK>>
  user_id : int <<FK, unique>>
  contract_type : varchar
  weekly_hours : decimal(4,1) <<null>>
}

entity Qualification {
  * id : int <<PK>>
  --
  company_id : int <<FK>>
  name : varchar
  description : varchar
  ..
  unique (company_id, name)
}

entity Employee_Qualification {
  * id : bigint <<PK>>
  --
  employee_id : int <<FK>>
  qualification_id : int <<FK>>
  ..
  unique (employee_id, qualification_id)
}

entity ShiftTemplate {
  * id : int <<PK>>
  --
  company_id : int <<FK>>
  name : varchar
  start : time
  end : time
  description : varchar
  ..
  unique (company_id, name)
}

entity Month {
  * id : int <<PK>>
  --
  company_id : int <<FK>>
  date : date
  revision : int
  demand_saved : boolean
  deadline : date <<null>>
  open_weekdays : varchar(7)
  ..
  unique (company_id, date)
}

entity MonthDay {
  * id : int <<PK>>
  --
  month_id : int <<FK>>
  date : date
  is_open : boolean
  ..
  unique (month_id, date)
}

entity Slot {
  * id : int <<PK>>
  --
  month_id : int <<FK>>
  template_id : int <<FK>>
  date : date
  total : smallint
  ..
  unique (date, template_id)
}

entity Need {
  * id : int <<PK>>
  --
  slot_id : int <<FK>>
  qualification_id : int <<FK>>
  count : smallint
  ..
  unique (slot_id, qualification_id)
}

entity Availability {
  * id : int <<PK>>
  --
  employee_id : int <<FK>>
  slot_id : int <<FK>>
  priority : smallint
  ..
  unique (employee_id, slot_id)
}

entity Submission {
  * id : int <<PK>>
  --
  employee_id : int <<FK>>
  month_id : int <<FK>>
  submitted : boolean
  updated_at : datetime
  ..
  unique (employee_id, month_id)
}

entity Vacation {
  * id : int <<PK>>
  --
  employee_id : int <<FK>>
  start : date
  end : date
}

entity Plan {
  * id : int <<PK>>
  --
  month_id : int <<FK, unique>>
  revision : int
  created_at : datetime
  duration_ms : int
}

entity Assignment {
  * id : int <<PK>>
  --
  plan_id : int <<FK>>
  slot_id : int <<FK>>
  employee_id : int <<FK, null>>
  position : smallint
  role : varchar
  priority : smallint <<null>>
  date : date
  shift_name : varchar
  start : time
  end : time
  employee_name : varchar
  ..
  unique (plan_id, slot_id, position)
}

entity PublishedPlan {
  * id : int <<PK>>
  --
  month_id : int <<FK, unique>>
  published_by_id : int <<FK, null>>
  published_at : datetime
  source_fingerprint : varchar(64)
  source_input_revision : int
}

entity PublishedAssignment {
  * id : int <<PK>>
  --
  publication_id : int <<FK>>
  employee_id : int <<FK, null>>
  position : int
  employee_name : varchar
  date : date
  shift_name : varchar
  start : time
  end : time
  role : varchar
  ..
  unique (publication_id, position)
}

auth_user ||--o| CompanyAccount
Company ||--o{ CompanyAccount
Company ||--o| PlanningSettings
Company ||--o{ Employee
Company ||--o{ Qualification
Company ||--o{ ShiftTemplate
Company ||--o{ Month
Month ||--o| PublishedPlan
auth_user |o--o{ PublishedPlan
PublishedPlan ||--o{ PublishedAssignment
Employee |o--o{ PublishedAssignment
auth_user ||--o| Employee
Employee ||--o{ Employee_Qualification
Qualification ||--o{ Employee_Qualification
Employee ||--o{ Availability
Employee ||--o{ Submission
Employee ||--o{ Vacation
Employee |o--o{ Assignment

Month ||--o{ MonthDay
Month ||--o{ Slot
Month ||--o{ Submission
Month ||--o| Plan
ShiftTemplate ||--o{ Slot
Slot ||--o{ Need
Qualification ||--o{ Need
Slot ||--o{ Availability
Plan ||--o{ Assignment
Slot ||--o{ Assignment

@enduml
